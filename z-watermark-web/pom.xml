<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-watermark</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-watermark-web</artifactId>
    <name>水印引擎 :: web</name>
    <packaging>jar</packaging>

    <description>水印引擎：显式文字/图片水印 + 图片隐写（LSB）+ 盲水印溯源（traceId 盲水印）（web：/api/watermark/** REST 管控面 + AutoConfiguration 装配）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-watermark-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 引擎装配在 starter 里（M2 #23 拆分）：web 只保留管控面（控制器 + 健康检查 + 数据源
             + 溯源 SPI 实现）。依赖 starter ⇒ 独立进程跑管控面时引擎 bean 照常装配出来，
             且 starter 会自动接上本模块提供的 AuditTraceHttpClient（溯源闭环）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-watermark-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ModuleDataSourceTemplate 所在：z.base.db.* 键名模式的权威实现。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MybatisSqlSessionFactoryBean（本域 sqlSessionFactory 装配用）。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 本地夹具库：DDL 幂等与接口可路由两个验收项都在 H2 上跑，不连任何真实库。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
